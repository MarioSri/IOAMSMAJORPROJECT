# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration (custom backend JWT for legacy auth flows)
JWT_SECRET=your_jwt_secret_key

# -- Supabase (Backend Admin) --------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Dashboard -> Settings -> API -> JWT Secret
# Required so the backend can verify tokens issued by Supabase Auth
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE

# -- Google Drive (Service Account) --------------------------------------------
# Option A: path to the downloaded JSON key file (relative to backend/)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# Option B: paste entire JSON inline (overrides Option A if both are set)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Shared Drive folder ID where uploaded files will be stored
GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE

# Max upload size in MB (default 25)
MAX_FILE_SIZE_MB=25

# Resend API (email notifications)
RESEND_API_KEY=your_resend_api_key

# AI Summarizer APIs
# Primary: NanoNets OCR (https://app.nanonets.com)
NANONETS_API_KEY=your_nanonets_api_key
# Fallback for images: Google Cloud Vision (https://console.cloud.google.com)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key
# Summarization: Google Gemini 2.5 Flash (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# CORS Configuration
FRONTEND_URL=http://localhost:5173
