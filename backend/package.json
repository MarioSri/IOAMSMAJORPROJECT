{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "name-backend",
  "version": "1.0.0",
  "description": "Backend for Name Document Management System",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --config eslint.config.cjs",
    "test": "jest --config jest.config.js --runInBand",
    "start": "node dist/server.js",
    "migrate": "node -e \"console.log('No migrations configured')\"",
    "test:email-config": "npx tsx src/validate-email-config.ts",
    "test:email-templates": "npx tsx src/test-email-templates.ts",
    "verify:rekor-monitoring": "node -r dotenv/config -r ts-node/register src/verify-rekor-monitoring.ts",
    "test:integration": "node scripts/check-integration-env.cjs && jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@sigstore/bundle": "^3.0.0",
    "@sigstore/sign": "^3.0.0",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/compression": "^1.8.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "^1.24.1",
    "resend": "^6.9.2",
    "svix": "^1.90.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^1.4.8",
    "@types/node": "^20.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.13",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
